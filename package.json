{
  "name": "atrium-ui",
  "version": "0.1.0",
  "description": "Atrium-UI: the MOSAIC interface (tokens, animations, components, app shell) as a reusable vanilla TypeScript library",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "main": "./dist/atrium-ui.cjs",
  "module": "./dist/atrium-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/atrium-ui.js",
      "require": "./dist/atrium-ui.cjs"
    },
    "./electron": {
      "types": "./dist/types/electron/index.d.ts",
      "import": "./dist/electron.js",
      "require": "./dist/electron.cjs"
    },
    "./preload": "./dist/preload.cjs",
    "./style.css": "./dist/atrium-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "build:playground": "vite build --mode playground",
    "preview:playground": "vite preview --mode playground",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bootstrap-icons": "^1.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
